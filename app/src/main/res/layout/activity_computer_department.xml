<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ComputerDepartment"
    android:background="#EAEAEA">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10sp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5sp"
            android:weightSum="100"
            android:background="@drawable/teachercardback"
            android:layout_marginTop="10sp"
            android:layout_marginBottom="10sp">
            <ImageView
                android:layout_width="80sp"
                android:layout_height="120sp"
                android:src="@drawable/provassir"
                android:layout_weight="20"
                android:scaleType="fitXY"
                android:contentDescription="@string/img_des"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="50"
                android:layout_gravity="center"
                android:paddingStart="15sp"
                android:paddingEnd="0sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="প্রভাস কান্তি দে"
                    android:textStyle="bold"
                    android:textSize="20sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ইন্সট্রাক্টর (টেক) কম্পিউটার"
                    android:textSize="10sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="বিভাগী প্রধান, কম্পিউয়ার সাইন্স অ্যান্ড টেকনোলোজি"
                    android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="30"
                android:layout_gravity="center"
                android:paddingRight="10sp">
                <ImageView
                    android:id="@+id/cmtMail1"
                    android:layout_width="30sp"
                    android:layout_height="30sp"
                    android:src="@drawable/baseline_email_24"
                    android:layout_margin="10sp"
                    android:contentDescription="@string/img_des"/>
                <ImageView
                    android:id="@+id/cmtCall1"
                    android:layout_width="30sp"
                    android:layout_height="30sp"
                    android:src="@drawable/baseline_call_24"
                    android:layout_margin="10sp"
                    android:contentDescription="@string/img_des"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5sp"
            android:weightSum="100"
            android:background="@drawable/teachercardback"
            android:layout_marginTop="10sp"
            android:layout_marginBottom="10sp">
            <ImageView
                android:layout_width="80sp"
                android:layout_height="120sp"
                android:src="@drawable/masudsir"
                android:layout_weight="20"
                android:scaleType="fitXY"
                android:contentDescription="@string/img_des"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="50"
                android:layout_gravity="center"
                android:paddingLeft="15sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মোঃ মাসুদ রানা"
                    android:textStyle="bold"
                    android:textSize="20sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ইনস্ট্রাক্টর, কম্পিউয়ার সাইন্স অ্যান্ড টেকনোলোজি"
                    android:textSize="10sp"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="30"
                android:layout_gravity="center"
                android:paddingRight="10sp">
                <ImageView
                    android:id="@+id/cmtMail2"
                    android:layout_width="30sp"
                    android:layout_height="30sp"
                    android:src="@drawable/baseline_email_24"
                    android:layout_margin="10sp"
                    android:contentDescription="@string/img_des"/>
                <ImageView
                    android:id="@+id/cmtCall2"
                    android:layout_width="30sp"
                    android:layout_height="30sp"
                    android:src="@drawable/baseline_call_24"
                    android:layout_margin="10sp"
                    android:contentDescription="@string/img_des"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5sp"
            android:weightSum="100"
            android:background="@drawable/teachercardback"
            android:layout_marginTop="10sp"
            android:layout_marginBottom="10sp">
            <ImageView
                android:layout_width="80sp"
                android:layout_height="120sp"
                android:src="@drawable/azizsir"
                android:layout_weight="20"
                android:scaleType="fitXY"
                android:contentDescription="@string/img_des"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="50"
                android:layout_gravity="center"
                android:paddingLeft="15sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="আহমেদ রফিক আজিজ"
                    android:textStyle="bold"
                    android:textSize="20sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ইন্সট্রাক্টর , কম্পিউয়ার সাইন্স অ্যান্ড টেকনোলোজি"
                    android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="30"
                android:layout_gravity="center"
                android:paddingRight="10sp">
                <ImageView
                    android:id="@+id/cmtMail3"
                    android:layout_width="30sp"
                    android:layout_height="30sp"
                    android:src="@drawable/baseline_email_24"
                    android:layout_margin="10sp"
                    android:contentDescription="@string/img_des"/>
                <ImageView
                    android:id="@+id/cmtCall3"
                    android:layout_width="30sp"
                    android:layout_height="30sp"
                    android:src="@drawable/baseline_call_24"
                    android:layout_margin="10sp"
                    android:contentDescription="@string/img_des"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5sp"
            android:weightSum="100"
            android:background="@drawable/teachercardback"
            android:layout_marginTop="10sp"
            android:layout_marginBottom="10sp">
            <ImageView
                android:layout_width="80sp"
                android:layout_height="120sp"
                android:src="@drawable/shawonsir"
                android:layout_weight="20"
                android:scaleType="fitXY"
                android:contentDescription="@string/img_des"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="50"
                android:layout_gravity="center"
                android:paddingLeft="15sp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="শরিফুল ইসলাম"
                    android:textStyle="bold"
                    android:textSize="20sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ইন্সট্রাক্টর, কম্পিউয়ার সাইন্স অ্যান্ড টেকনোলোজি"
                    android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="30"
                android:layout_gravity="center"
                android:paddingRight="10sp">
                <ImageView
                    android:id="@+id/cmtMail4"
                    android:layout_width="30sp"
                    android:layout_height="30sp"
                    android:src="@drawable/baseline_email_24"
                    android:layout_margin="10sp"
                    android:contentDescription="@string/img_des"/>
                <ImageView
                    android:id="@+id/cmtCall4"
                    android:layout_width="30sp"
                    android:layout_height="30sp"
                    android:src="@drawable/baseline_call_24"
                    android:layout_margin="10sp"
                    android:contentDescription="@string/img_des"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</ScrollView>