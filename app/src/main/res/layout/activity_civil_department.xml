                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ইনস্ট্রাক্টর, সিভিল টেকনোলোজি"
                    android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="30"
