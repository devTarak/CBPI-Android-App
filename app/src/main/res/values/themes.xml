<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CBPI" parent="Theme.Material3.DayNight">
        <item name="android:statusBarColor">@color/Green</item>
        <item name="titleTextColor">@color/white</item>
        <item name="actionOverflowButtonStyle">@style/Threedots</item>
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>
    <style name="fullViewTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/white</item>
    </style>
    <style name="Threedots" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="tint">@color/white</item>
    </style>
    <style name="Theme.CBPI" parent="Base.Theme.CBPI" />
</resources>