<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CBPI" parent="Theme.Material3.DayNight">
        <item name="android:statusBarColor">@color/Green</item>
        <item name="titleTextColor">@color/white</item>
        <item name="actionOverflowButtonStyle">@style/Threedots</item>
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowAnimationStyle">@style/CustomActivityAnimation</item>
    </style>
    <style name="Spalshal" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/Green</item>
    </style>
    <style name="fullViewTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/white</item>
    </style>
    <style name="Threedots" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="tint">@color/white</item>
    </style>
    <!--Controle Day Text Color-->
        <style name="Text">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="TextLight">
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="TextGray">
        <item name="android:textColor">@color/Gray</item>
    </style>
    <style name="GrayBg">
        <item name="android:background">#EAEAEA</item>
    </style>
    <style name="TeacherCardBack">
        <item name="android:background">@drawable/teachercardback</item>
    </style>
    <style name="TeacherBg">
        <item name="android:background">@drawable/teachersbg</item>
    </style>
    <style name="BorderT">
        <item name="android:background">@drawable/border</item>
    </style>
    <!--end Text Color-->
    <style name="Theme.CBPI" parent="Base.Theme.CBPI" />
    <style name="CustomActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>